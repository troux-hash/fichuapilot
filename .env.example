# Copy to .env for local overrides. On Vercel, set these in Project → Settings → Environment Variables.

# Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=

# Admin login password (required in production). Local runs (scripts/dev.py) use "admin".
ADMIN_PASSWORD=

# Long random string used to sign login cookies:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Payments. Empty = Fichua's built-in test checkout (no real money).
# Stripe → Developers → API keys → Secret key (sk_test_... while testing).
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://<site>/api/stripe/webhook → Signing secret.
STRIPE_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta). Empty = messages are only logged in Admin → WhatsApp messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Protects /api/cron/payouts (Vercel sends it automatically to the daily cron).
CRON_SECRET=

# Local only (not needed on Vercel): lets scripts/vercel_status.py check deployments.
VERCEL_TOKEN=

# Optional
APP_NAME=Fichua
MAX_UPLOAD_MB=4
AUTO_MIGRATE=true
