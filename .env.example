# Copy to .env for local overrides. On Vercel, set these in Project → Settings → Environment Variables.

# Supabase: Project → Connect → "Transaction pooler" URI (port 6543). Leave empty locally to use SQLite.
DATABASE_URL=

# Admin login password. Required in production (admin is disabled without it). Local default: admin
ADMIN_PASSWORD=

# Long random string used to sign admin cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local only (not needed on Vercel): lets scripts/vercel_status.py check deployments.
# Create at vercel.com/account/settings/tokens
VERCEL_TOKEN=

# Optional
APP_NAME=Fichua
MAX_UPLOAD_MB=4
AUTO_MIGRATE=true
