{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{fichua/**,public/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/payouts", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
